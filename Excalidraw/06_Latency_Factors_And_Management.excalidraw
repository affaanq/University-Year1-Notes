{"type":"excalidraw","version":2,"source":"https://excalidraw.com","elements":[{"id":"title","type":"text","x":100,"y":10,"width":900,"height":38,"text":"PHYSICAL LAYER — Latency: 7 Factors & 4 Management Strategies","fontSize":22,"fontFamily":1,"textAlign":"center","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"latency-def","type":"rectangle","x":60,"y":60,"width":980,"height":40,"strokeColor":"#e03131","backgroundColor":"#ffe3e3","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"latency-def-t","type":"text","x":60,"y":72,"width":980,"height":20,"text":"LATENCY = Delay in data transmission from source to destination","fontSize":15,"fontFamily":1,"textAlign":"center","strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"factors-title","type":"text","x":60,"y":118,"width":980,"height":26,"text":"7 FACTORS THAT AFFECT LATENCY","fontSize":18,"fontFamily":1,"textAlign":"center","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f1-box","type":"rectangle","x":60,"y":155,"width":290,"height":75,"strokeColor":"#1971c2","backgroundColor":"#dbe4ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f1-t","type":"text","x":68,"y":160,"width":274,"height":60,"text":"1. TRANSMISSION MEDIA\nFiber optic = faster, lower latency\nCopper = slower, higher latency","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f2-box","type":"rectangle","x":370,"y":155,"width":290,"height":75,"strokeColor":"#1971c2","backgroundColor":"#dbe4ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f2-t","type":"text","x":378,"y":160,"width":274,"height":60,"text":"2. DISTANCE\nGreater distance between\nsource & destination = higher latency","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f3-box","type":"rectangle","x":680,"y":155,"width":360,"height":75,"strokeColor":"#1971c2","backgroundColor":"#dbe4ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f3-t","type":"text","x":688,"y":160,"width":344,"height":60,"text":"3. NETWORK TRAFFIC CONGESTION\nMore data than network can handle\n→ Packets queue up → Delays","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f4-box","type":"rectangle","x":60,"y":250,"width":290,"height":75,"strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f4-t","type":"text","x":68,"y":255,"width":274,"height":60,"text":"4. NETWORK EQUIPMENT\nQuality of routers, switches, NICs\nPoor equipment = more processing delay","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f5-box","type":"rectangle","x":370,"y":250,"width":290,"height":75,"strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f5-t","type":"text","x":378,"y":255,"width":274,"height":60,"text":"5. NETWORK STRUCTURE (HOPS)\nNumber of devices between\nsource & destination → More hops = more latency","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f6-box","type":"rectangle","x":680,"y":250,"width":360,"height":75,"strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f6-t","type":"text","x":688,"y":255,"width":344,"height":60,"text":"6. PROTOCOL OVERHEADS (TCP/IP)\nError checking, packet sequencing,\nacknowledgments → All add latency","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"f7-box","type":"rectangle","x":60,"y":345,"width":980,"height":75,"strokeColor":"#f08c00","backgroundColor":"#fff3bf","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"f7-t","type":"text","x":68,"y":350,"width":964,"height":60,"text":"7. APPLICATION / SERVICE TYPE\n• Real-time (gaming, video conferencing) → High latency = noticeable delays & disruptions\n• Cloud/web browsing → High latency = slower page loads & data retrieval","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"manage-title","type":"text","x":60,"y":445,"width":980,"height":26,"text":"4 STRATEGIES TO MANAGE LATENCY","fontSize":18,"fontFamily":1,"textAlign":"center","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"m1-box","type":"rectangle","x":60,"y":482,"width":230,"height":90,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"m1-t","type":"text","x":68,"y":487,"width":214,"height":80,"text":"1. OPTIMISE\nINFRASTRUCTURE\n→ Direct interconnection\n→ Fewer hops between nodes","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"m2-box","type":"rectangle","x":310,"y":482,"width":230,"height":90,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"m2-t","type":"text","x":318,"y":487,"width":214,"height":80,"text":"2. FASTER\nTRANSMISSION MEDIA\n→ High-speed routers\n→ Fiber optic cables","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"m3-box","type":"rectangle","x":560,"y":482,"width":230,"height":90,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"m3-t","type":"text","x":568,"y":487,"width":214,"height":80,"text":"3. EFFICIENT ROUTING\nPROTOCOLS\n→ Use UDP (less overhead)\n→ No handshaking/ACKs","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"m4-box","type":"rectangle","x":810,"y":482,"width":230,"height":90,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},{"id":"m4-t","type":"text","x":818,"y":487,"width":214,"height":80,"text":"4. CDNs\n(Content Delivery Networks)\n→ Cache content closer\n   to end-users\n→ Reduces physical distance","fontSize":12,"fontFamily":1,"textAlign":"left","strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100},{"id":"exam-note","type":"text","x":60,"y":590,"width":980,"height":20,"text":"⚠️ EXAM TIP: Know all 7 factors AND all 4 management strategies. UDP reduces latency because it has LESS overhead than TCP.","fontSize":13,"fontFamily":1,"textAlign":"center","strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100}],"appState":{"viewBackgroundColor":"#ffffff","gridSize":null}}